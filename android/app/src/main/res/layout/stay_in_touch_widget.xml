<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:background="#F7F5EE">

    <!-- POLAROID PHOTO AREA (Dominant visual area occupying top space) -->
    <LinearLayout
        android:id="@+id/widget_image_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:background="#EFECE4"
        android:padding="1dp">

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- PLACEHOLDER CONTAINER (Visible when no image uploaded) -->
        <LinearLayout
            android:id="@+id/widget_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#EFECE4"
            android:padding="8dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/widget_placeholder_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="22sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widget_placeholder_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No photo uploaded"
                android:textColor="#9E988E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- SUBSTANTIALLY LARGER POLAROID BOTTOM CHIN (CENTERED TEXT LIKE ACTUAL POLAROID) -->
    <LinearLayout
        android:id="@+id/widget_bottom_chin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- HEADER ROW: Avatar + Member Name + Counter (Centered) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="3dp">

            <ImageView
                android:id="@+id/widget_avatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stay in Touch"
                android:textColor="#1C1917"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="1/1"
                android:textColor="#8C857B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PRESENCE CAPTION (CENTERED LIKE HANDWRITTEN POLAROID CAPTION) -->
        <TextView
            android:id="@+id/widget_presence_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No updates yet..."
            android:textColor="#292524"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- TIMESTAMP PRINTED CAPTION (CENTERED) -->
        <TextView
            android:id="@+id/widget_updated_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="3dp"
            android:text="Tap to cycle friends"
            android:textColor="#8C857B"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
